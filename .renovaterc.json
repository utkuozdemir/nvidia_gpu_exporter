{
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":automergeBranch",
    ":automergeMinor",
    ":automergeDigest",
    ":semanticCommitTypeAll(chore)"
  ],
  "ignorePresets": [
    ":ignoreModulesAndTests"
  ],
  "osvVulnerabilityAlerts": true,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "go"
      ],
      "groupName": "go packages"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "enabled": true
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "groupName": "docker images"
    },
    {
      "extends": [
        ":automergeMajor"
      ],
      "matchFileNames": [
        ".github/workflows/**"
      ],
      "groupName": "github actions"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.github\\/workflows\\/.*/",
        "/Taskfile\\.yml/",
        "/hack\\/dev\\.Dockerfile/",
        "/hack\\/.*\\.sh/",
        "/charts\\/.*\\/templates\\/.*\\.yaml/"
      ],
      "matchStrings": [
        "# renovate: depName=(?<depName>[^\\s]+)( datasource=(?<datasource>[^\\s]+))?( registryUrl=(?<registryUrl>\\S+))?\\n[^\\n]*?(?<currentValue>v?\\d+\\.\\d+\\.\\d+(-[\\S]+)?)"
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}github-tags{{/if}}",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/go.mod/",
        "/\\.github\\/workflows\\/.*/",
        "/hack\\/dev\\.Dockerfile/"
      ],
      "matchStrings": [
        "(#|\\/\\/) renovate: go\\n[^\\n]*?(?<currentValue>v?\\d+\\.\\d+(\\.\\d+(-[\\S]+)?)?)"
      ],
      "depNameTemplate": "golang/go",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^go(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/charts\\/.*\\/README\\.md/"
      ],
      "matchStrings": [
        "\\| test\\.image\\.tag \\| string \\| `\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"` \\|"
      ],
      "depNameTemplate": "docker.io/library/busybox",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    }
  ]
}
